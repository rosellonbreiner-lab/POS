{
  "name": "mototaller",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key ./certificates/server.key --experimental-https-cert ./certificates/server.crt -H 0.0.0.0",
    "dev:http": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "update:safe": "node scripts/safe-update.mjs",
    "db:backup": "node scripts/safe-update.mjs --backup-only",
    "db:restore": "node scripts/safe-update.mjs --restore-latest",
    "db:verify": "node scripts/safe-update.mjs --verify",
    "postinstall": "prisma generate",
    "lint": "eslint"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@prisma/client": "^6.6.0",
    "@types/animejs": "^3.1.12",
    "animejs": "^3.2.2",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.7.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/recharts": "^1.8.29",
    "@types/selfsigned": "^2.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.6.0",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
